<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- ========== Cum Shooter ========== -->

	<Operation Class="CombatExtended.PatchOperationMakeGunCECompatible">
		<defName>RJW_U_CumShotGun</defName>
		<statBases>
			<Mass>3.5</Mass>
			<RangedWeapon_Cooldown>0.5</RangedWeapon_Cooldown>
			<SightsEfficiency>1.0</SightsEfficiency>
			<ShotSpread>0.10</ShotSpread>
			<SwayFactor>1.0</SwayFactor>
			<Bulk>10.0</Bulk>
			<WorkToMake>20000</WorkToMake>
		</statBases>
		<costList>
			<Steel>50</Steel>
			<ComponentIndustrial>5</ComponentIndustrial>
			<Cumpilation_Cum>50</Cumpilation_Cum>
		</costList>
		<Properties>
			<recoilAmount>1.0</recoilAmount>
			<verbClass>CombatExtended.Verb_ShootCE</verbClass>
			<hasStandardCommand>true</hasStandardCommand>
			<defaultProjectile>RJW_U_Bullet_Cum_CE</defaultProjectile>
			<warmupTime>1.0</warmupTime>
			<range>30</range>
			<soundCast>Shot_AssaultRifle</soundCast>
			<soundCastTail>GunTail_Medium</soundCastTail>
			<muzzleFlashScale>9</muzzleFlashScale>
		</Properties>
		<AmmoUser>
			<magazineSize>50</magazineSize>
			<reloadTime>5</reloadTime>
			<ammoSet>AmmoSet_RJW_U_CumShot</ammoSet>
		</AmmoUser>
		<FireModes>
			<aimedBurstShotCount>3</aimedBurstShotCount>
			<aiUseBurstMode>TRUE</aiUseBurstMode>
			<aiAimMode>AimedShot</aiAimMode>
		</FireModes>
		<weaponTags>
			<li>CE_AI_AR</li>
		</weaponTags>
		<researchPrerequisite>Gunsmithing</researchPrerequisite>
	</Operation>

	<!-- ========== Melee tools ========== -->

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="RJW_U_CumShotGun"]/tools</xpath>
		<value>
			<tools>
				<li Class="CombatExtended.ToolCE">
					<label>stock</label>
					<capacities>
						<li>Blunt</li>
					</capacities>
					<power>8</power>
					<cooldownTime>1.5</cooldownTime>
					<armorPenetrationBlunt>0.75</armorPenetrationBlunt>
					<linkedBodyPartsGroup>Stock</linkedBodyPartsGroup>
				</li>
				<li Class="CombatExtended.ToolCE">
					<label>grip</label>
					<capacities>
						<li>Blunt</li>
					</capacities>
					<power>5</power>
					<cooldownTime>2.0</cooldownTime>
					<chanceFactor>0.75</chanceFactor>
					<armorPenetrationBlunt>0.6</armorPenetrationBlunt>
					<linkedBodyPartsGroup>Grip</linkedBodyPartsGroup>
				</li>
				<li Class="CombatExtended.ToolCE">
					<label>muzzle</label>
					<capacities>
						<li>Poke</li>
					</capacities>
					<power>8</power>
					<cooldownTime>1.5</cooldownTime>
					<armorPenetrationBlunt>0.55</armorPenetrationBlunt>
					<linkedBodyPartsGroup>Muzzle</linkedBodyPartsGroup>
				</li>
			</tools>
		</value>
	</Operation>

	<!-- ========== Mortar shells: make them valid CE shells ========== -->

	<Operation Class="PatchOperationAttributeAdd">
		<xpath>Defs/ThingDef[defName="RJW_Shell_Aphrodisiac" or defName="RJW_Shell_Cum" or defName="RJW_U_ShellDollification" or defName="RJW_U_ShellFuckmeatification" or defName="RJW_U_ShellFurryfication" or defName="RJW_U_ShellGayBomb"]</xpath>
		<attribute>Class</attribute>
		<value>CombatExtended.AmmoDef</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="RJW_Shell_Aphrodisiac" or defName="RJW_Shell_Cum" or defName="RJW_U_ShellDollification" or defName="RJW_U_ShellFuckmeatification" or defName="RJW_U_ShellFurryfication" or defName="RJW_U_ShellGayBomb"]</xpath>
		<value>
			<isMortarAmmo>true</isMortarAmmo>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="RJW_Bullet_Shell_Aphrodisiac" or defName="RJW_Bullet_Shell_Cum" or defName="RJW_U_BulletShellDollification" or defName="RJW_U_BulletShellFuckmeatification" or defName="RJW_U_BulletShellFurryfication" or defName="RJW_U_BulletShellGayBomb"]</xpath>
		<value>
			<thingClass>CombatExtended.ProjectileCE_Explosive</thingClass>
		</value>
	</Operation>

	<Operation Class="PatchOperationAttributeAdd">
		<xpath>Defs/ThingDef[defName="RJW_Bullet_Shell_Aphrodisiac" or defName="RJW_Bullet_Shell_Cum" or defName="RJW_U_BulletShellDollification" or defName="RJW_U_BulletShellFuckmeatification" or defName="RJW_U_BulletShellFurryfication" or defName="RJW_U_BulletShellGayBomb"]/projectile</xpath>
		<attribute>Class</attribute>
		<value>CombatExtended.ProjectilePropertiesCE</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/CombatExtended.AmmoSetDef[defName="AmmoSet_81mmMortarShell"]/ammoTypes</xpath>
		<value>
			<RJW_Shell_Aphrodisiac>RJW_Bullet_Shell_Aphrodisiac</RJW_Shell_Aphrodisiac>
			<RJW_Shell_Cum>RJW_Bullet_Shell_Cum</RJW_Shell_Cum>
			<RJW_U_ShellDollification>RJW_U_BulletShellDollification</RJW_U_ShellDollification>
			<RJW_U_ShellFuckmeatification>RJW_U_BulletShellFuckmeatification</RJW_U_ShellFuckmeatification>
			<RJW_U_ShellFurryfication>RJW_U_BulletShellFurryfication</RJW_U_ShellFurryfication>
			<RJW_U_ShellGayBomb>RJW_U_BulletShellGayBomb</RJW_U_ShellGayBomb>
		</value>
	</Operation>

	<!-- ========== Xenogenetic warhead ========== -->

	<Operation Class="PatchOperationAttributeAdd">
		<xpath>Defs/ThingDef[defName="RJW_U_XenogeneticWarhead"]</xpath>
		<attribute>Class</attribute>
		<value>CombatExtended.AmmoDef</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="RJW_U_XenogeneticWarhead"]</xpath>
		<value>
			<isMortarAmmo>true</isMortarAmmo>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="RJW_U_Bullet_XenogeneticWarhead"]/thingClass</xpath>
		<value>
			<thingClass>RJW_Unleashed_Combat.CE.ProjectileCE_XenogeneticWarhead</thingClass>
		</value>
	</Operation>

	<Operation Class="PatchOperationAttributeAdd">
		<xpath>Defs/ThingDef[defName="RJW_U_Bullet_XenogeneticWarhead"]/projectile</xpath>
		<attribute>Class</attribute>
		<value>CombatExtended.ProjectilePropertiesCE</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/CombatExtended.AmmoSetDef[defName="AmmoSet_81mmMortarShell"]/ammoTypes</xpath>
		<value>
			<RJW_U_XenogeneticWarhead>RJW_U_Bullet_XenogeneticWarhead</RJW_U_XenogeneticWarhead>
		</value>
	</Operation>

	<!-- ========== Common CE ammo fields for all converted shells ========== -->

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="RJW_Bullet_Shell_Aphrodisiac" or defName="RJW_Bullet_Shell_Cum" or defName="RJW_U_BulletShellDollification" or defName="RJW_U_BulletShellFuckmeatification" or defName="RJW_U_BulletShellFurryfication" or defName="RJW_U_BulletShellGayBomb" or defName="RJW_U_Bullet_XenogeneticWarhead"]/projectile</xpath>
		<value>
			<damageAmountBase>1</damageAmountBase>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="RJW_Bullet_Shell_Aphrodisiac" or defName="RJW_Bullet_Shell_Cum" or defName="RJW_U_BulletShellDollification" or defName="RJW_U_BulletShellFuckmeatification" or defName="RJW_U_BulletShellFurryfication" or defName="RJW_U_BulletShellGayBomb"]/projectile</xpath>
		<value>
			<speed>0</speed>
			<gravityFactor>5</gravityFactor>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="RJW_U_Bullet_XenogeneticWarhead"]/projectile/speed</xpath>
		<value>
			<speed>0</speed>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="RJW_U_Bullet_XenogeneticWarhead"]/projectile</xpath>
		<value>
			<gravityFactor>5</gravityFactor>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="RJW_Shell_Aphrodisiac"]</xpath>
		<value>
			<ammoClass>RJW_U_AmmoCat_Aphrodisiac</ammoClass>
			<cookOffProjectile>RJW_Bullet_Shell_Aphrodisiac</cookOffProjectile>
			<detonateProjectile>RJW_Bullet_Shell_Aphrodisiac</detonateProjectile>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="RJW_Shell_Cum"]</xpath>
		<value>
			<ammoClass>RJW_U_AmmoCat_Cum</ammoClass>
			<cookOffProjectile>RJW_Bullet_Shell_Cum</cookOffProjectile>
			<detonateProjectile>RJW_Bullet_Shell_Cum</detonateProjectile>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="RJW_U_ShellDollification"]</xpath>
		<value>
			<ammoClass>RJW_U_AmmoCat_Dollification</ammoClass>
			<cookOffProjectile>RJW_U_BulletShellDollification</cookOffProjectile>
			<detonateProjectile>RJW_U_BulletShellDollification</detonateProjectile>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="RJW_U_ShellFuckmeatification"]</xpath>
		<value>
			<ammoClass>RJW_U_AmmoCat_Fuckmeatification</ammoClass>
			<cookOffProjectile>RJW_U_BulletShellFuckmeatification</cookOffProjectile>
			<detonateProjectile>RJW_U_BulletShellFuckmeatification</detonateProjectile>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="RJW_U_ShellFurryfication"]</xpath>
		<value>
			<ammoClass>RJW_U_AmmoCat_Furryfication</ammoClass>
			<cookOffProjectile>RJW_U_BulletShellFurryfication</cookOffProjectile>
			<detonateProjectile>RJW_U_BulletShellFurryfication</detonateProjectile>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="RJW_U_ShellGayBomb"]</xpath>
		<value>
			<ammoClass>RJW_U_AmmoCat_GayBomb</ammoClass>
			<cookOffProjectile>RJW_U_BulletShellGayBomb</cookOffProjectile>
			<detonateProjectile>RJW_U_BulletShellGayBomb</detonateProjectile>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="RJW_U_XenogeneticWarhead"]</xpath>
		<value>
			<ammoClass>RJW_U_AmmoCat_XenogeneticWarhead</ammoClass>
			<cookOffProjectile>RJW_U_Bullet_XenogeneticWarhead</cookOffProjectile>
			<detonateProjectile>RJW_U_Bullet_XenogeneticWarhead</detonateProjectile>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="RJW_Shell_Aphrodisiac" or defName="RJW_Shell_Cum" or defName="RJW_U_ShellDollification" or defName="RJW_U_ShellFuckmeatification" or defName="RJW_U_ShellFurryfication" or defName="RJW_U_ShellGayBomb"]</xpath>
		<value>
			<thingClass>CombatExtended.AmmoThing</thingClass>
			<alwaysHaulable>true</alwaysHaulable>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="RJW_U_XenogeneticWarhead"]/thingClass</xpath>
		<value>
			<thingClass>CombatExtended.AmmoThing</thingClass>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="RJW_U_XenogeneticWarhead"]</xpath>
		<value>
			<alwaysHaulable>true</alwaysHaulable>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="RJW_Shell_Aphrodisiac" or defName="RJW_Shell_Cum" or defName="RJW_U_ShellDollification" or defName="RJW_U_ShellFuckmeatification" or defName="RJW_U_ShellFurryfication" or defName="RJW_U_ShellGayBomb" or defName="RJW_U_XenogeneticWarhead"]/comps</xpath>
		<value>
			<li Class="CompProperties_Forbiddable"/>
		</value>
	</Operation>

</Patch>
