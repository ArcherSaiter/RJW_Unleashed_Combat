<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="OrbitalUtilityBase">
    <defName>RJW_U_OrbitalLustRayPointer</defName>
    <label>orbital lust ray pointer</label>
    <description>A hijacked satellite targeting unit. Aimed at a location, it commands an orbital lust array to focus a wide ray of lust-inducing psychic energy onto the area, drenching everything beneath it in waves of overwhelming desire until the network detects the unauthorized signal and permanently locks the unit out.</description>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponSpecial/RJW_U_OrbitalLustRayPointer/RJW_U_OrbitalLustRayPointer</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.7,0.7)</drawSize>
    </graphicData>
    <thingSetMakerTags>
      <li>RewardStandardHighFreq</li>
    </thingSetMakerTags>
    <apparel>
      <ai_pickUpOpportunistically>true</ai_pickUpOpportunistically>
      <wornGraphicPath>Things/Item/Equipment/WeaponSpecial/RJW_U_OrbitalLustRayPointer/RJW_U_OrbitalLustRayPointer</wornGraphicPath>
      <wornGraphicData>
        <renderUtilityAsPack>true</renderUtilityAsPack>
        <north>
          <male>  <offset>(0.25, -0.25)</offset> </male>
          <female><offset>(0.25,-0.25)</offset> </female>
          <thin>  <offset>(0.15,-0.25)</offset> </thin>
          <hulk>  <offset>(0.25,-0.3)</offset> </hulk>
          <fat>   <offset>(0.45,-0.25)</offset> </fat>
        </north>
        <south>
          <male>  <offset>(-0.3, -0.25)</offset> </male>
          <female><offset>(-0.3,-0.25)</offset> </female>
          <thin>  <offset>(-0.2,-0.25)</offset> </thin>
          <hulk>  <offset>(-0.3,-0.3)</offset> </hulk>
          <fat>   <offset>(-0.5,-0.25)</offset> </fat>
        </south>
        <east>
          <offset>(-0.05,-0.3)</offset>
        </east>

        <male>  <scale>(0.4,0.4)</scale> </male>
        <female><scale>(0.4,0.4)</scale> </female>
        <thin>  <scale>(0.4,0.4)</scale> </thin>
        <hulk>  <scale>(0.4,0.4)</scale> </hulk>
        <fat>   <scale>(0.4,0.4)</scale> </fat>
      </wornGraphicData>
    </apparel>
    <verbs>
      <li Class="RJW_Unleashed_Combat.VerbProperties_LustRay">
        <verbClass>RJW_Unleashed_Combat.Verb_CastLustRay</verbClass>
        <strikeDef>RJW_U_OrbitalLustRay</strikeDef>
        <durationTicks>1250</durationTicks>
        <hasStandardCommand>true</hasStandardCommand>
        <useableInPocketMaps>false</useableInPocketMaps>
        <warmupTime>3</warmupTime>
        <ai_AvoidFriendlyFireRadius>15</ai_AvoidFriendlyFireRadius>
        <range>44.9</range>
        <burstShotCount>1</burstShotCount>
        <soundAiming>OrbitalTargeter_Aiming</soundAiming>
        <soundCast>OrbitalTargeter_Fire</soundCast>
        <onlyManualCast>true</onlyManualCast>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
      </li>
    </verbs>
    <comps>
      <li Class="CompProperties_ApparelReloadable">
        <maxCharges>1</maxCharges>
        <destroyOnEmpty>true</destroyOnEmpty>
        <hotKey>Misc4</hotKey>
        <chargeNoun>charge</chargeNoun>
        <displayGizmoWhileUndrafted>false</displayGizmoWhileUndrafted>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="OrbitalStrikeBase">
    <defName>RJW_U_OrbitalLustRay</defName>
    <label>orbital lust ray</label>
    <thingClass>RJW_Unleashed_Combat.OrbitalLustRay</thingClass>
    <modExtensions>
      <li Class="RJW_Unleashed_Combat.LustRayExtension">
        <lustAmount>0.1</lustAmount>
        <radius>15</radius>
        <intervalTicks>30</intervalTicks>
        <hitsPerInterval>0</hitsPerInterval> <!-- hitsPerInterval 0 = all, >0 = N random pawns; -->
      </li>
    </modExtensions>
    <comps>
      <li Class="CompProperties_OrbitalBeam">
        <width>8</width>
        <color>(255, 105, 180, 242)</color>
        <sound>OrbitalBeam</sound>
      </li>
      <li Class="CompProperties_CameraShaker">
        <mag>0.03</mag>
      </li>
      <li Class="CompProperties_AffectsSky">
        <skyColors>
          <sky>(255, 180, 210)</sky>
          <shadow>(220, 150, 185)</shadow>
          <overlay>(255, 230, 240)</overlay>
          <saturation>1.2</saturation>
        </skyColors>
      </li>
    </comps>
  </ThingDef>

</Defs>
