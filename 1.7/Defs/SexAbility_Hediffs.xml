<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <HediffDef>
    <defName>RJWUC_Seduced</defName>
    <label>seduced</label>
    <description>This person has been seduced out of the fight and is about to flee the map.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <initialSeverity>0.001</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <isBad>false</isBad>
    <tendable>false</tendable>
	<stages>
        <li>
            <becomeVisible>false</becomeVisible>
        </li>
    </stages>
    <comps>
      <li Class="RJW_Unleashed_Combat.HediffCompProperties_SeducedEscape" />
    </comps>
  </HediffDef>

