<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef Name="RJW_Unleashed_ShellBase" ParentName="ResourceBase" Abstract="True">
    <soundInteract>Metal_Drop</soundInteract>
    <soundDrop>Standard_Drop</soundDrop>
    <tickerType>Normal</tickerType>
    <stackLimit>75</stackLimit>
    <techLevel>Industrial</techLevel>
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
      <MarketValue>75</MarketValue>
      <Mass>1</Mass>
      <Flammability>1.0</Flammability>
      <DeteriorationRate>2</DeteriorationRate>
    </statBases>
    <thingCategories>
      <li>MortarShells</li>
    </thingCategories>
    <tradeTags>
      <li>MortarShell</li>
    </tradeTags>
	<recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <effectWorking>Cook</effectWorking>
      <soundWorking>Recipe_Machining</soundWorking>
      <workAmount>800</workAmount>
      <targetCountAdjustment>5</targetCountAdjustment>
      <workSkill>Crafting</workSkill>
      <recipeUsers>
        <li>TableMachining</li>
      </recipeUsers>
      <skillRequirements>
        <Crafting>4</Crafting>
      </skillRequirements>
      <displayPriority>100</displayPriority>
	  <researchPrerequisite>Mortars</researchPrerequisite>
    </recipeMaker>
  </ThingDef>
  
  <ThingDef Name="RJW_Bullet_Base" ParentName="BaseBullet" Abstract="True">
    <thingClass>Projectile_Explosive</thingClass>
    <projectile>
      <speed>41</speed>
      <explosionRadius>5</explosionRadius>
      <flyOverhead>true</flyOverhead>
      <soundHitThickRoof>Artillery_HitThickRoof</soundHitThickRoof>
      <soundExplode>Explosion_EMP</soundExplode>
      <soundImpactAnticipate>MortarRound_PreImpact</soundImpactAnticipate>
      <soundAmbient>MortarRound_Ambient</soundAmbient>
      <applyDamageToExplosionCellsNeighbors>true</applyDamageToExplosionCellsNeighbors>
      <explosionEffect>ExtinguisherExplosion</explosionEffect>
    </projectile>
  </ThingDef>

  <ThingDef Name="RJW_U_FilthBase" ParentName="BaseFilth" Abstract="True">
    <statBases>
      <Beauty>-30</Beauty>
      <Cleanliness>-10</Cleanliness>
    </statBases>
    <filth>
      <ignoreFilthMultiplierStat>true</ignoreFilthMultiplierStat>
      <disappearsInDays>35~40</disappearsInDays>
      <rainWashes>true</rainWashes>
      <cleaningWorkToReduceThickness>70</cleaningWorkToReduceThickness>
      <canFilthAttach>true</canFilthAttach>
      <cleaningSound>Interact_CleanFilth_Fluid</cleaningSound>
    </filth>
  </ThingDef>

  <DamageDef Name="RJW_U_DamageBase" ParentName="Bomb" Abstract="True">
    <workerClass>RJW_Unleashed_Combat.ExtendedDamageWorker</workerClass>
    <canInterruptJobs>false</canInterruptJobs>
    <makesBlood>false</makesBlood>
    <defaultDamage>1</defaultDamage>
    <explosionCellFleck>BlastExtinguisher</explosionCellFleck>
    <explosionColorEdge>(1, 1, 1, 0.05)</explosionColorEdge>
    <soundExplosion>Explosion_Stun</soundExplosion>
    <harmsHealth>false</harmsHealth>
    <combatLogRules>Damage_Extinguish</combatLogRules>
    <consideredHelpful>false</consideredHelpful>
  </DamageDef>

  <ThingDef Name="RJW_U_GeneticShellBase" ParentName="RJW_Unleashed_ShellBase" Abstract="True">
    <comps>
      <li Class="CompProperties_Explosive">
        <explosiveRadius>9.9</explosiveRadius>
        <explosiveExpandPerStackcount>0.4</explosiveExpandPerStackcount>
        <startWickHitPointsPercent>0.7</startWickHitPointsPercent>
        <applyDamageToExplosionCellsNeighbors>true</applyDamageToExplosionCellsNeighbors>
        <explosionEffect>ExtinguisherExplosion</explosionEffect>
        <wickTicks>30~60</wickTicks>
      </li>
    </comps>
  </ThingDef>

  <RecipeDef Name="RJW_U_ShellRecipeBase" Abstract="True">
    <workAmount>800</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <workSkill>Crafting</workSkill>
    <recipeUsers>
      <li>TableMachining</li>
    </recipeUsers>
    <skillRequirements>
      <Crafting>4</Crafting>
    </skillRequirements>
    <researchPrerequisite>Mortars</researchPrerequisite>
  </RecipeDef>

</Defs>
