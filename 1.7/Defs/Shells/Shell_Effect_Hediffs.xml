    <isBad>true</isBad>
    <tendable>false</tendable>
	<stages>
        <li>
            <label>wet</label>
            <minSeverity>0.35</minSeverity>
            <becomeVisible>true</becomeVisible>
            <capMods>
                <li>
                    <capacity>Moving</capacity>
                    <offset>-0.1</offset>
