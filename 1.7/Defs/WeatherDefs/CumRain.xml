<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <WeatherDef>
    <defName>RJWUC_CumRain</defName>
    <label>cum rain</label>
    <isBad>true</isBad>
    <description>It is raining cum. The air is thick and sticky, and everything left out in the open is soon coated in a layer of it.</description>
    <temperatureRange>-999~999</temperatureRange>
    <windSpeedFactor>1.5</windSpeedFactor>
    <accuracyMultiplier>0.8</accuracyMultiplier>
    <favorability>Neutral</favorability>
    <perceivePriority>2</perceivePriority>
    <weatherThought>SoakingWet</weatherThought>
    <rainRate>1</rainRate>
    <moveSpeedMultiplier>0.9</moveSpeedMultiplier>
    <durationRange>3000~5000</durationRange>
    <ambientSounds>
      <li>Ambient_Rain</li>
    </ambientSounds>
    <overlayClasses>
      <li>WeatherOverlay_Rain</li>
    </overlayClasses>
    <eventMakers>
      <li>
        <averageInterval>700</averageInterval>
        <eventClass>RJW_Unleashed_Combat.WeatherEvent_CumFall</eventClass>
      </li>
    </eventMakers>
    <commonalityRainfallFactor>
      <points>
        <li>(0, 0)</li>
        <li>(10000, 0)</li>
      </points>
    </commonalityRainfallFactor>
    <!-- Colors are Overcast -->
