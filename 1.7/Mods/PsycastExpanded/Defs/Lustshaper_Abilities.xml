  <!-- 6. Release Desire -->
  <VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
    <defName>RJW_VPE_ReleaseDesire</defName>
    <label>release desire</label>
    <description>Unleash a wave of psychic energy centered on the caster, inflaming overwhelming lust in beings caught in the blast.</description>
    <iconPath>Abilities/Lustshaper/ReleaseDesire</iconPath>
    <abilityClass>RJW_Unleashed_VPE.Ability_LustPulse</abilityClass>
    <castTime>30</castTime>
    <range>0</range>
    <targetMode>Self</targetMode>
    <castSound>VPE_SelfExplosion_Cast</castSound>
    <targetingParameters>
      <canTargetSelf>true</canTargetSelf>
    </targetingParameters>
    <radius>8.9</radius>
    <power>0.35</power>
    <powerStatFactors>
      <PsychicSensitivity>0.5</PsychicSensitivity>
    </powerStatFactors>
	<radiusStatFactors>
      <PsychicSensitivity>0.5</PsychicSensitivity>
    </radiusStatFactors>
    <modExtensions>
      <li Class="VanillaPsycastsExpanded.AbilityExtension_Psycast">
        <path>RJW_Lustshaper</path>
        <level>3</level>
        <order>1</order>
        <psyfocusCost>0.20</psyfocusCost>
        <entropyGain>60</entropyGain>
        <prerequisites>
          <li>RJW_VPE_LustShield</li>
          <li>RJW_VPE_RayOfDesire</li>
        </prerequisites>
      </li>
    </modExtensions>
  </VEF.Abilities.AbilityDef>

  <!-- 7. Passion Surge -->
