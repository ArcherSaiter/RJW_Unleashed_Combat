<?xml version="1.0" encoding="UTF-8"?>
<Defs>
  <!-- 1. Lust Spike -->
  <VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
    <defName>RJW_VPE_LustSpike</defName>
    <label>lust spike</label>
    <description>Condenses casters lewd thoughts into a psychic lancing bolt of pure lust, slamming into a target and igniting their desire.</description>
    <iconPath>Abilities/Lustshaper/LustSpike</iconPath>
    <abilityClass>RJW_Unleashed_VPE.Ability_LustSpike</abilityClass>
    <castTime>30</castTime>
    <range>19.9</range>
    <targetMode>Pawn</targetMode>
    <castSound>VPE_IceSpike_Cast</castSound>
    <targetingParameters>
      <canTargetPawns>true</canTargetPawns>
      <canTargetBuildings>false</canTargetBuildings>
    </targetingParameters>
    <power>0.05</power>
    <powerStatFactors>
      <PsychicSensitivity>0.5</PsychicSensitivity>
    </powerStatFactors>
    <modExtensions>
      <li Class="VanillaPsycastsExpanded.AbilityExtension_Psycast">
        <path>RJW_Lustshaper</path>
        <level>1</level>
        <order>1</order>
        <psyfocusCost>0.02</psyfocusCost>
        <entropyGain>12</entropyGain>
      </li>
      <li Class="VEF.Abilities.AbilityExtension_Projectile">
        <projectile>RJW_VPE_LustSpike</projectile>
      </li>
      <li Class="VEF.Abilities.AbilityExtension_Hediff">
        <hediff>RJW_VPE_LustSpike</hediff>
      </li>
    </modExtensions>
  </VEF.Abilities.AbilityDef>

  <!-- 2. Pheromone Breath -->
  <VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
    <defName>RJW_VPE_PheromoneBreath</defName>
    <label>pheromone breath</label>
    <description>Exhale a cloud of pheromones that rapidly inflame lust of all caught in its path.</description>
    <iconPath>Abilities/Lustshaper/PheromoneBreath</iconPath>
    <abilityClass>RJW_Unleashed_VPE.Ability_LustRay</abilityClass>
    <castTime>60</castTime>
    <range>9.9</range>
    <targetMode>Location</targetMode>
    <castSound>VPE_BreatheFlame_Cast</castSound>
    <targetingParameters>
      <canTargetLocations>true</canTargetLocations>
      <canTargetPawns>true</canTargetPawns>
      <canTargetBuildings>false</canTargetBuildings>
    </targetingParameters>
	<powerStatFactors>
      <PsychicSensitivity>0.5</PsychicSensitivity>
    </powerStatFactors>
    <modExtensions>
      <li Class="VanillaPsycastsExpanded.AbilityExtension_Psycast">
        <path>RJW_Lustshaper</path>
        <level>1</level>
        <order>2</order>
        <psyfocusCost>0.05</psyfocusCost>
        <entropyGain>26</entropyGain>
      </li>
      <li Class="VEF.Abilities.AbilityExtension_Projectile">
        <projectile>RJW_VPE_PheromoneBreath</projectile>
      </li>
    </modExtensions>
  </VEF.Abilities.AbilityDef>

  <!-- 3. Lust Shield -->
  <VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
    <defName>RJW_VPE_LustShield</defName>
    <label>lust shield</label>
    <description>Enfold a target in a field of projected lust that can shield them from external lust manipulation. Due to the nature of this field, it also forces psychic desire upon any melee attackers trying to breach through it.</description>
    <iconPath>Abilities/Lustshaper/LustShield</iconPath>
    <abilityClass>VEF.Abilities.Ability_Blank</abilityClass>
    <castTime>30</castTime>
    <range>9.9</range>
    <targetMode>Pawn</targetMode>
    <castSound>VPE_IceShield_Cast</castSound>
    <targetingParameters>
      <canTargetPawns>true</canTargetPawns>
      <canTargetBuildings>false</canTargetBuildings>
      <canTargetSelf>true</canTargetSelf>
    </targetingParameters>
    <durationTime>600</durationTime>
	<durationTimeStatFactors>
      <PsychicSensitivity>0.5</PsychicSensitivity>
    </durationTimeStatFactors>
    <showUndrafted>true</showUndrafted>
    <modExtensions>
      <li Class="VanillaPsycastsExpanded.AbilityExtension_Psycast">
        <path>RJW_Lustshaper</path>
        <level>2</level>
        <order>2</order>
        <psyfocusCost>0.05</psyfocusCost>
        <entropyGain>25</entropyGain>
		<prerequisites>
          <li>RJW_VPE_LustSpike</li>
		  <li>RJW_VPE_PheromoneBreath</li>
        </prerequisites>
      </li>
      <li Class="VEF.Abilities.AbilityExtension_Hediff">
        <hediff>RJW_VPE_LustShield</hediff>
      </li>
    </modExtensions>
  </VEF.Abilities.AbilityDef>

  <!-- 4. Ray of Desire -->
  <VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
    <defName>RJW_VPE_RayOfDesire</defName>
    <label>ray of desire</label>
