  <!-- 8. Lust Cyclon -->
  <VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
    <defName>RJW_VPE_LustCyclon</defName>
    <label>lust cyclon</label>
    <description>Create a roaring vortex of manifested lust, rapidly making anyone in its way hopelessly horny.</description>
    <iconPath>Abilities/Lustshaper/LustCyclon</iconPath>
    <abilityClass>RJW_Unleashed_VPE.Ability_LustCyclon</abilityClass>
    <castTime>60</castTime>
    <range>30.0</range>
    <targetMode>Location</targetMode>
    <castSound>VPE_FireTornado_Cast</castSound>
    <targetingParameters>
      <canTargetLocations>true</canTargetLocations>
    </targetingParameters>
    <radius>4.9</radius>
    <power>0.10</power>
    <durationTime>1800</durationTime>
    <durationTimeStatFactors>
      <PsychicSensitivity>0.5</PsychicSensitivity>
    </durationTimeStatFactors>
    <powerStatFactors>
      <PsychicSensitivity>0.5</PsychicSensitivity>
    </powerStatFactors>
    <modExtensions>
      <li Class="VanillaPsycastsExpanded.AbilityExtension_Psycast">
        <path>RJW_Lustshaper</path>
        <level>4</level>
        <order>1</order>
        <psyfocusCost>0.40</psyfocusCost>
        <entropyGain>150</entropyGain>
        <prerequisites>
          <li>RJW_VPE_ReleaseDesire</li>
          <li>RJW_VPE_PassionSurge</li>
        </prerequisites>
      </li>
    </modExtensions>
  </VEF.Abilities.AbilityDef>

  <!-- 9. Lust Storm -->
  <VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
    <defName>RJW_VPE_LustStorm</defName>
    <label>lust storm</label>
    <description>Unleash a titanic psychic storm of manifested lust around the caster, ceaselessly forcing lewd thoughts and sexual urges into minds across the surrounding area for its duration.</description>
    <iconPath>Abilities/Lustshaper/LustStorm</iconPath>
    <abilityClass>VEF.Abilities.Ability_Blank</abilityClass>
    <castTime>120</castTime>
    <range>0</range>
    <targetMode>Self</targetMode>
	<goodwillImpact>-50</goodwillImpact>
	<warmupStartSound>Psycast_Neuroquake_CastStart</warmupStartSound>
    <warmupSound>Psycast_Neuroquake_CastLoop</warmupSound>
    <warmupPreEndSound>Psycast_Neuroquake_CastEnd</warmupPreEndSound>
    <targetingParameters>
      <canTargetSelf>true</canTargetSelf>
    </targetingParameters>
    <radius>15</radius>
    <power>0.10</power>
    <durationTime>1250</durationTime>
    <powerStatFactors>
      <PsychicSensitivity>0.5</PsychicSensitivity>
    </powerStatFactors>
	<durationTimeStatFactors>
      <PsychicSensitivity>0.5</PsychicSensitivity>
    </durationTimeStatFactors>
	<radiusStatFactors>
      <PsychicSensitivity>0.5</PsychicSensitivity>
    </radiusStatFactors>
    <showUndrafted>false</showUndrafted>
    <modExtensions>
      <li Class="VanillaPsycastsExpanded.AbilityExtension_Psycast">
        <path>RJW_Lustshaper</path>
        <level>5</level>
        <order>1</order>
        <psyfocusCost>0.80</psyfocusCost>
        <entropyGain>300</entropyGain>
        <prerequisites>
          <li>RJW_VPE_LustCyclon</li>
        </prerequisites>
      </li>
      <li Class="VEF.Abilities.AbilityExtension_Hediff">
        <hediff>RJW_VPE_LustStormSource</hediff>
        <applyToCaster>true</applyToCaster>
		<durationMultiplier>PsychicSensitivity</durationMultiplier>
      </li>
    </modExtensions>
  </VEF.Abilities.AbilityDef>
</Defs>
