    <radius>4.9</radius>
    <power>0.35</power>
    <powerStatFactors>
      <PsychicSensitivity>0.5</PsychicSensitivity>
    </powerStatFactors>
    <!--<radiusStatFactors>
      <PsychicSensitivity>0.5</PsychicSensitivity>
    </radiusStatFactors>-->
    <modExtensions>
      <li Class="VanillaPsycastsExpanded.AbilityExtension_Psycast">
        <path>RJW_Lustshaper</path>
        <level>3</level>
        <order>2</order>
        <psyfocusCost>0.20</psyfocusCost>
