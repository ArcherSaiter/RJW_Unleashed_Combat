    <iconPath>Abilities/Lustshaper/RayOfDesire</iconPath>
    <abilityClass>RJW_Unleashed_VPE.Ability_LustRay</abilityClass>
    <durationTime>240</durationTime>
    <durationTimeStatFactors>
      <PsychicSensitivity>0.5</PsychicSensitivity>
    </durationTimeStatFactors>
    <castTime>30</castTime>
    <range>12.9</range>
    <targetMode>Location</targetMode>
    <castSound>VPE_EyeBlast_Cast</castSound>
    <targetingParameters>
      <canTargetLocations>true</canTargetLocations>
      <canTargetPawns>true</canTargetPawns>
      <canTargetBuildings>false</canTargetBuildings>
    </targetingParameters>
    <powerStatFactors>
      <PsychicSensitivity>0.5</PsychicSensitivity>
    </powerStatFactors>
	<power>0.20</power>
    <modExtensions>
      <li Class="VanillaPsycastsExpanded.AbilityExtension_Psycast">
        <path>RJW_Lustshaper</path>
        <level>2</level>
        <order>1</order>
        <psyfocusCost>0.05</psyfocusCost>
        <entropyGain>30</entropyGain>
		<prerequisites>
          <li>RJW_VPE_LustSpike</li>
        </prerequisites>
      </li>
      <li Class="VEF.Abilities.AbilityExtension_Projectile">
        <projectile>RJW_VPE_LustRay</projectile>
      </li>
      <li Class="VEF.Abilities.AbilityExtension_Hediff">
        <hediff>RJW_VPE_RayOfDesire</hediff>
      </li>
    </modExtensions>
  </VEF.Abilities.AbilityDef>

  <!-- 5. Pheromonous Crystal -->
  <VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
    <defName>RJW_VPE_PheromoneCrystal</defName>
    <label>pheromonous crystal</label>
    <description>Manifest a temporary crystal of concentrated pheromones that instill lewd thoughts in anyone passig by.</description>
    <iconPath>Abilities/Lustshaper/PheromoneCrystal</iconPath>
    <abilityClass>VEF.Abilities.Ability_SpawnBuilding</abilityClass>
    <castTime>30</castTime>
    <range>9.9</range>
    <targetMode>Location</targetMode>
    <castSound>VPE_IceCrystal_Cast</castSound>
    <targetingParameters>
      <canTargetLocations>true</canTargetLocations>
      <canTargetBuildings>false</canTargetBuildings>
    </targetingParameters>
    <durationTime>60000</durationTime>
	<powerStatFactors>
      <PsychicSensitivity>0.5</PsychicSensitivity>
    </powerStatFactors>
	<durationTimeStatFactors>
      <PsychicSensitivity>0.25</PsychicSensitivity>
    </durationTimeStatFactors>
    <showUndrafted>true</showUndrafted>
    <modExtensions>
      <li Class="VanillaPsycastsExpanded.AbilityExtension_Psycast">
        <path>RJW_Lustshaper</path>
        <level>2</level>
        <order>3</order>
        <psyfocusCost>0.10</psyfocusCost>
        <entropyGain>30</entropyGain>
		<prerequisites>
          <li>RJW_VPE_PheromoneBreath</li>
        </prerequisites>
      </li>
      <li Class="VEF.Abilities.AbilityExtension_Building">
