<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <Operation Class="VEF.PatchOperationToggableSequence">
    <enabled>True</enabled>
    <label>RJW: Cum filth is not washed away by rain</label>
    <operations>
      <li Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName="FilthCum"]/filth</xpath>
        <match Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="FilthCum"]/filth/rainWashes</xpath>
          <value>
            <rainWashes>false</rainWashes>
          </value>
        </match>
        <nomatch Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="FilthCum"]</xpath>
          <value>
            <filth>
              <rainWashes>false</rainWashes>
            </filth>
          </value>
        </nomatch>
      </li>
    </operations>
  </Operation>
</Patch>
